generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id          String   @id @default(uuid())
  nombre      String
  telefono    String
  direccion   String
  lat         Float?
  lng         Float?
  desde       String
  hasta       String
  fecha       String
  paquete     String
  pago        String
  estadoPago  String   @default("Pendiente")
  estado      String   @default("Pendiente")
  archivado   Boolean  @default(false)
  total       Float?
  comprobante String?
  createdAt   DateTime @default(now())
}

model Precios {
  id         Int   @id @default(autoincrement())
  individual Float
  media      Float
  clasico    Float
  familiar   Float
}

model Stock {
  id        Int @id @default(autoincrement())
  stock     Int
  threshold Int @default(10)
}

model Config {
  id                 Int     @id @default(autoincrement())
  horarioCierre      String  @default("05:00")
  horarioCierreFecha String?
  forzadoCerrado     Boolean @default(false)
  fechaForzado       String?
  cierreHasta        String?
  radioKm            Float   @default(1)
  alias              String?
}

